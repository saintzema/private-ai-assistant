# =============================================================================
# Private AI Knowledge Assistant — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Private AI Knowledge Assistant"
ENVIRONMENT=development   # development | staging | production
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (no Docker): postgresql+asyncpg://postgres@localhost:5432/private_ai
# Development (Docker): postgresql+asyncpg://postgres:postgres@db:5432/private_ai
# Production (RDS):     postgresql+asyncpg://user:pass@rds-endpoint:5432/private_ai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/private_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=private_ai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local dev (no Docker): redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ── AI Provider ────────────────────────────────────────────────────────────────
# "openai", "bedrock", or "gemini"
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
GEMINI_API_KEY=AIzaSy...
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
MAX_TOKENS=4096
TEMPERATURE=0.7

# ── AWS Credentials ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ── S3 ─────────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=private-ai-documents
S3_PRESIGNED_URL_EXPIRY=3600

# ── AWS Bedrock (optional — use instead of OpenAI) ─────────────────────────────
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ── AWS Marketplace ────────────────────────────────────────────────────────────
AWS_MARKETPLACE_ENABLED=false
AWS_MARKETPLACE_PRODUCT_CODE=
AWS_MARKETPLACE_REGION=us-east-1

# ── Email / SMTP ───────────────────────────────────────────────────────────────
EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@private-ai.io
FROM_NAME="Private AI Assistant"

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_HOUR=10

# ── Document Processing ────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=50

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Private AI Assistant"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourapp.com
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.csv

# ── Monitoring (optional) ──────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Feature Flags ──────────────────────────────────────────────────────────────
ENABLE_MARKETPLACE=false
ENABLE_EMAIL_VERIFICATION=true
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true

# ── Flower (Celery Dashboard) ──────────────────────────────────────────────────
FLOWER_BASIC_AUTH=admin:change-this-password

# ── Production / ECS ───────────────────────────────────────────────────────────
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPO_BACKEND=private-ai-backend
ECR_REPO_FRONTEND=private-ai-frontend
ECS_CLUSTER=private-ai-cluster
ECS_SERVICE_BACKEND=private-ai-backend-service
IMAGE_TAG=latest
